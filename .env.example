# =============================================================
# Configuration de l'application CABBA
#
# Copiez ce fichier vers .env et renseignez les valeurs.
#   cp .env.example .env
#
# .env est ignoré par git : il ne doit jamais être commité.
# =============================================================


# --- Base de données --------------------------------------------------------
# Chaîne de connexion PostgreSQL. Obligatoire.
# En production, son absence arrête le serveur au démarrage.
#
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
# Sur un hébergeur qui impose TLS, ajoutez ?sslmode=require à la fin.
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/cabba


# --- Sessions ---------------------------------------------------------------
# Secret de signature des cookies de session. Obligatoire en production,
# 32 caractères au minimum.
#
# Quiconque connaît cette valeur peut forger un cookie d'administrateur :
# elle doit être aléatoire, propre à chaque environnement, et jamais partagée.
#
# Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=


# --- Assistant IA -----------------------------------------------------------
# Clé de l'API Google Gemini, pour l'assistant des supporters.
# Optionnelle : sans elle, /api/chat répond 503 et le reste de
# l'application fonctionne normalement.
# À créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=


# --- Serveur ----------------------------------------------------------------
# Port d'écoute. Optionnel, 3000 par défaut.
# Cloud Run et la plupart des hébergeurs imposent leur propre valeur :
# ne la fixez pas en production.
# PORT=3000

# Interface d'écoute. Optionnel, 0.0.0.0 par défaut (toutes les interfaces).
# HOST=0.0.0.0

# Passe l'application en mode production : cookies en secure, service worker
# actif, front servi depuis dist/ au lieu du serveur de développement Vite.
# NODE_ENV=production


# --- API-Football ----------------------------------------------------------
# Optionnelle : sans clé, la synchronisation football reste désactivée.
API_FOOTBALL_KEY=
# IDs à récupérer avec : npm run football:verify -- --league "Ligue 2" --team "Bordj"
API_FOOTBALL_LEAGUE_ID=
API_FOOTBALL_TEAM_ID=
API_FOOTBALL_SEASON=2026
# Marge de sécurité sous le quota gratuit API-Football.
API_FOOTBALL_DAILY_QUOTA=90
API_FOOTBALL_TIMEOUT_MS=8000

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com


# Stockage média Cloudflare R2 (optionnel en développement)
# Les fichiers sont envoyés directement vers R2 via URL pré-signée ; Express ne
# reçoit pas les octets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cabba-media
# URL publique du bucket ou domaine custom, sans slash final.
R2_PUBLIC_BASE_URL=


# --- Emails transactionnels --------------------------------------------------
# CABBA utilise l'API HTTP Resend côté serveur. Ne mettez jamais cette clé
# dans le frontend. EMAIL_FROM doit être une adresse autorisée par votre
# domaine d'envoi.
RESEND_API_KEY=
EMAIL_FROM=CABBA <noreply@example.com>
APP_BASE_URL=http://localhost:3000

# Analytics is PostgreSQL-backed and requires no third-party analytics key.
# Events intentionally avoid IP addresses and raw personal data.
